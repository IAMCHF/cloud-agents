#!/bin/sh
# 提交门禁：控制面 ruff/mypy/pytest + web biome/tsc/vitest + jscpd 克隆检测。
# 启用：pnpm run hooks:install（等价 git config core.hooksPath .githooks）。
# 规模变大后再按「受影响文件」裁剪；P1 全量跑约数秒。
set -eu

cd "$(dirname "$0")/.."

# uv 可能只装在用户目录（~/.local/bin）而未入 PATH。
if ! command -v uv >/dev/null 2>&1; then
  if [ -x "$HOME/.local/bin/uv" ]; then
    PATH="$HOME/.local/bin:$PATH"
    export PATH
  else
    echo "[pre-commit] 未找到 uv，无法检查 control-plane。安装后重试：https://docs.astral.sh/uv/" >&2
    exit 1
  fi
fi

exec pnpm run --silent check
