# 控制面环境变量模板：复制为 .env 后填值；任何真实密钥都不入库。
# 地址一律用部署方提供的内部域名/IP，禁止写进文档或代码。

# 控制面对外基址（沙箱回连 WSS、LLM 网关地址由它派生）
PUBLIC_BASE_URL=http://127.0.0.1:8000

# P1 单租户鉴权（管理面 Bearer token）与会话属主
P1_AUTH_TOKEN=change-me
P1_OWNER=p1-user

# OpenSandbox 生命周期 API
OPENSANDBOX_BASE_URL=http://127.0.0.1:8080
OPENSANDBOX_API_KEY=change-me
SANDBOX_IMAGE=cloud-agents/sandbox:0.1.0
SANDBOX_CPU=2
SANDBOX_MEMORY=2Gi
SANDBOX_TIMEOUT_SECONDS=3600
SANDBOX_START_TIMEOUT_SECONDS=90
MAX_ACTIVE_SESSIONS=24

# 用户卷（Docker 模式 host 挂载；必须落在 OpenSandbox storage.allowed_host_paths 下）
VOLUME_BACKEND=host
WORKSPACE_HOST_ROOT=/srv/cloud-agents/volumes
WORKSPACE_MOUNT_PATH=/workspace

# 部署用（compose 读取）：OpenSandbox 配置文件在宿主机上的绝对路径
SANDBOX_CONFIG_PATH=/srv/cloud-agents/sandbox.toml

# Postgres（compose 初始化用）
POSTGRES_DB=cloud_agents
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# LLM 网关上游（真 key 只在这里；沙箱只拿会话 token）
LLM_UPSTREAM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=600
# 沙箱内 codex 的模型名 / 推理强度 / 上下文窗口（codex 0.167 只支持 Responses API）
CODEX_MODEL=
CODEX_REASONING_EFFORT=
CODEX_CONTEXT_WINDOW=0
# 容器即隔离边界；codex 不再套 bwrap（容器内无 user namespace 权限）
CODEX_SANDBOX_MODE=danger-full-access
CODEX_APPROVAL_POLICY=on-request

# 台账与审计（Postgres 17）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/cloud_agents
AUDIT_FLUSH_INTERVAL_SECONDS=0.2
